[Unit]
Description=OmniBlob Storage Service
After=network.target postgresql.service

[Service]
Type=simple
User=omniblob
Group=omniblob
WorkingDirectory=/opt/omniblob
ExecStart=/opt/omniblob/omniblob --config /opt/omniblob/configs/config.yaml
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
