{
	"info": {
		"name": "OmniBlob API",
		"description": "Dokumentasi API untuk OmniBlob (pwni-file-sync). Termasuk Dashboard, Upload, Presigned URLs, dan Explorer.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "System",
			"item": [
				{
					"name": "1. Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"health"
							]
						}
					}
				}
			]
		},
		{
			"name": "File Management",
			"item": [
				{
					"name": "Upload File",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "file",
									"type": "file",
									"src": []
								},
								{
									"key": "referensi_id",
									"value": "{{referensi_id}}",
									"description": "ID referensi unik dari aplikasi Anda",
									"type": "text"
								},
								{
									"key": "module",
									"value": "{{bucket}}",
									"description": "Kategori / Modul aplikasi",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/{{bucket}}/upload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"{{bucket}}",
								"upload"
							]
						}
					}
				},
				{
					"name": "Bulk Upload Files",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "formdata",
							"formdata": [
								{
									"key": "files",
									"type": "file",
									"src": []
								},
								{
									"key": "files",
									"type": "file",
									"src": []
								},
								{
									"key": "referensi_id",
									"value": "{{referensi_id}}",
									"type": "text"
								},
								{
									"key": "module",
									"value": "{{bucket}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "{{base_url}}/api/v1/{{bucket}}/bulk-upload",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"{{bucket}}",
								"bulk-upload"
							]
						}
					}
				},
				{
					"name": "Get File by Internal ID (bin_id)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/{{bucket}}/{{bin_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"{{bucket}}",
								"{{bin_id}}"
							]
						}
					}
				},
				{
					"name": "Get File by Reference ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/{{bucket}}/view?ref_id={{referensi_id}}&module={{bucket}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"{{bucket}}",
								"view"
							],
							"query": [
								{
									"key": "ref_id",
									"value": "{{referensi_id}}"
								},
								{
									"key": "module",
									"value": "{{bucket}}"
								}
							]
						}
					}
				},
				{
					"name": "Generate Presigned URL",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/presign?bin_id={{file_id}}&expires_in=60",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"presign"
							],
							"query": [
								{
									"key": "bin_id",
									"value": "{{file_id}}",
									"description": "Gunakan bin_id untuk menargetkan 1 file spesifik (paling direkomendasikan)"
								},
								{
									"key": "expires_in",
									"value": "60"
								},
								{
									"key": "ref",
									"value": "{{referensi_id}}",
									"disabled": true,
									"description": "Alternatif: Gunakan ref dan module jika hanya 1 file per referensi"
								},
								{
									"key": "module",
									"value": "{{bucket}}",
									"disabled": true
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Dashboard & Explorer (Internal)",
			"item": [
				{
					"name": "Dashboard Summary",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/summary",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"dashboard",
								"summary"
							]
						}
					}
				},
				{
					"name": "Dashboard Analytics",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/analytics",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"dashboard",
								"analytics"
							]
						}
					}
				},
				{
					"name": "Dashboard Quality",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/dashboard/quality",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"dashboard",
								"quality"
							]
						}
					}
				},
				{
					"name": "Explorer List Directory",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "X-API-KEY",
								"value": "{{api_key}}",
								"type": "text"
							},
							{
								"key": "X-API-USER",
								"value": "{{api_user}}",
								"type": "text"
							},
							{
								"key": "X-API-PASS",
								"value": "{{api_pass}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/v1/explorer/list?target=legacy&path=/",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"explorer",
								"list"
							],
							"query": [
								{
									"key": "target",
									"value": "legacy",
									"description": "legacy or omniblob"
								},
								{
									"key": "path",
									"value": "/"
								}
							]
						}
					}
				}
			]
		}
	]
}
